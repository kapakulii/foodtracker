# LEGACY_USER_PASSWORD=

# CORS
# CORS_ALLOW_ORIGINS=http://localhost:8080

# ENV=production

# AI apply mode: partial (применить всё, что можно) или atomic (всё или ничего)
# AI_APPLY_MODE=partial
